# Copie para .env e preencha:  cp .env.example .env
#
# O .env NÃO é versionado (está no .gitignore) — é onde ficam os
# segredos. O docker-compose.yaml lê estas variáveis por ${VAR}, então
# para subir via Docker as da primeira seção precisam estar preenchidas.
#
# Para rodar fora do Docker (`task run`), tudo aqui é opcional: o
# settings.py tem padrões que funcionam com um Postgres local.

# =====================================================================
# Obrigatórias para o docker-compose
# =====================================================================

# ---- Banco ----
POSTGRES_USER=kamnews
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=kamnews

# ---- Autenticação ----
# Gere a sua com:  openssl rand -hex 32
# Quem conhece o valor consegue forjar tokens. Vazia, a aplicação se
# recusa a subir.
SECRET_KEY=

# ---- Seed (admin inicial e KAMs) ----
# Troque as senhas no primeiro acesso, pela aba Usuários.
# O domínio precisa ser válido: .local e .internal são de uso especial
# e o validador de e-mail os rejeita.
SEED_EMAIL_DOMAIN=kamnews.com.br
MASTER_EMAIL=admin@kamnews.com.br
MASTER_PASSWORD=troque-esta-senha
SEED_KAM_PASSWORD=troque-esta-senha

# ---- Assistente (chat) ----
# Pegue em https://console.groq.com/ (aba API Keys).
# Vazio = a aba Assistente fica desligada; o resto funciona normal.
GROQ_API_KEY=

# ---- Ollama ----
OLLAMA_MODEL=llama3.2

# =====================================================================
# Opcionais — descomente só para customizar
# =====================================================================

# Banco fora do Docker
# DATABASE_URL=postgresql+psycopg://kamnews:kamnews@localhost:5432/kamnews

# Autenticação
# ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=480

# Assistente
# Confira os modelos da sua conta na Groq: nem toda conta tem
# todos, e um indisponível devolve 404.
# CHAT_MODEL=openai/gpt-oss-120b
# CHAT_TIMEOUT=60
# CHAT_MAX_NOTICIAS=60
# CHAT_HISTORY_DAYS=7
# CHAT_MAX_PAGINA_CHARS=6000

# Ollama
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_NUM_PREDICT=700
# OLLAMA_NUM_CTX=4096
# OLLAMA_TIMEOUT=150

# Google News RSS
# NEWS_HL=pt-BR
# NEWS_GL=BR
# NEWS_CEID=BR:pt-BR
# Período padrão quando a busca não manda datas (máx. 60).
# NEWS_WINDOW_DAYS=30
# NEWS_MAX_ITEMS=30
# NEWS_TARGET_ITEMS=5
