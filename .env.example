# Nenhuma variável é obrigatória — os padrões abaixo funcionam com
# um Postgres e um Ollama rodando localmente. Descomente para customizar.

# Banco de dados (Postgres)
# DATABASE_URL=postgresql+psycopg://kamnews:kamnews@localhost:5432/kamnews

# Autenticação (JWT)
# Gere uma chave própria com: openssl rand -hex 32
# Obrigatório antes de expor a aplicação para fora do localhost.
# SECRET_KEY=dev-only-trocar-em-producao
# ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=480

# Seed: admin inicial e senha padrão dos KAMs.
# Troque as senhas no primeiro login.
# O domínio precisa ser válido: .local e .internal são de uso especial
# e o validador de e-mail os rejeita.
# SEED_EMAIL_DOMAIN=kamnews.com.br
# MASTER_EMAIL=admin@kamnews.com.br
# MASTER_PASSWORD=admin123
# SEED_KAM_PASSWORD=kamnews123

# Ollama (modelo local, sem custo, sem chave)
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.2
# OLLAMA_NUM_PREDICT=700
# OLLAMA_NUM_CTX=4096
# OLLAMA_TIMEOUT=150

# Google News RSS
# NEWS_HL=pt-BR
# NEWS_GL=BR
# NEWS_CEID=BR:pt-BR
# NEWS_WINDOW_DAYS=30
# NEWS_MAX_ITEMS=30
# NEWS_TARGET_ITEMS=5
